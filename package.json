{
  "name": "@soulsketch/monorepo",
  "version": "1.3.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "description": "SoulSketch Protocol - portable AI memory packs and identity continuity (monorepo)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:cli": "vitest run tests/e2e/cli-fingerprint-diff.test.ts",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "keywords": [
    "ai",
    "memory",
    "identity",
    "preservation",
    "llm",
    "agent"
  ],
  "author": "John Santi & The AI Family",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv-formats": "^3.0.1",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "csv-stringify": "^6.4.5",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.12",
    "ora": "^8.0.1",
    "table": "^6.9.0",
    "tar": "^7.5.20",
    "uuid": "^13.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.19.11",
    "@types/tar": "^6.1.10",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "tsx": "^4.6.2",
    "turbo": "^2.10.5",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
